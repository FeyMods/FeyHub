<div class="fp-body">

  {{!-- Currency --}}
  <section class="fp-section fp-coffers">
    <h3 class="fp-heading"><i class="fa-solid fa-coins"></i> {{localize "FEYPARTY.Coffers"}}
      {{#if canManage}}
      <button type="button" class="fp-icon fp-split" data-action="split" data-tooltip="FEYPARTY.Split.Button">
        <i class="fa-solid fa-people-arrows"></i>
      </button>
      {{/if}}
    </h3>

    {{#if currencies.length}}
    <ol class="fp-list">
      {{#each currencies}}
      <li class="fp-row fp-currency" data-id="{{id}}">
        <span class="fp-label">{{label}} <span class="fp-abbr">{{abbr}}</span></span>
        <button type="button" class="fp-icon" data-action="adjustCurrency" data-delta="-1"
                data-tooltip="{{localize "FEYPARTY.StepHint"}}"><i class="fa-solid fa-minus"></i></button>
        <input type="number" class="fp-num" data-field="currencyAmount" value="{{amount}}" min="0" step="1">
        <button type="button" class="fp-icon" data-action="adjustCurrency" data-delta="1"
                data-tooltip="{{localize "FEYPARTY.StepHint"}}"><i class="fa-solid fa-plus"></i></button>
        {{#if @root.canManage}}
        <button type="button" class="fp-icon fp-danger" data-action="removeCurrency"
                data-tooltip="FEYPARTY.RemoveCurrency"><i class="fa-solid fa-trash"></i></button>
        {{/if}}
      </li>
      {{/each}}
    </ol>

    <div class="fp-form fp-transaction">
      <input type="number" data-draft="txAmount" min="1" step="1" placeholder="{{localize "FEYPARTY.Amount"}}">
      <select data-draft="txCurrency">
        {{#each currencies}}<option value="{{id}}">{{label}}</option>{{/each}}
      </select>
      <input type="text" data-draft="txNote" maxlength="120" placeholder="{{localize "FEYPARTY.Note"}}">
      {{#if actors.length}}
      <label class="fp-actor" data-tooltip="FEYPARTY.ActorHint">
        <i class="fa-solid fa-user"></i>
        <select data-draft="txActor">
          <option value="">{{localize "FEYPARTY.StashOnly"}}</option>
          {{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </label>
      {{/if}}
      <button type="button" data-action="transaction" data-direction="deposit">
        <i class="fa-solid fa-piggy-bank"></i> {{localize "FEYPARTY.Deposit"}}
      </button>
      <button type="button" data-action="transaction" data-direction="withdraw">
        <i class="fa-solid fa-hand-holding-dollar"></i> {{localize "FEYPARTY.Withdraw"}}
      </button>
    </div>
    {{else}}
    <p class="fp-empty">{{localize "FEYPARTY.NoCurrencies"}}</p>
    {{/if}}

    {{#if canManage}}
    <div class="fp-form fp-add-currency">
      <input type="text" data-draft="currencyLabel" maxlength="32" placeholder="{{localize "FEYPARTY.CurrencyName"}}">
      <input type="text" data-draft="currencyAbbr" maxlength="6" class="fp-short" placeholder="{{localize "FEYPARTY.CurrencyAbbr"}}">
      <button type="button" data-action="addCurrency" data-default>
        <i class="fa-solid fa-plus"></i> {{localize "FEYPARTY.AddCurrency"}}
      </button>
    </div>
    {{/if}}
  </section>

  {{!-- Resources --}}
  <section class="fp-section fp-resources">
    <h3 class="fp-heading"><i class="fa-solid fa-box-open"></i> {{localize "FEYPARTY.Resources"}}</h3>

    {{#if resources.length}}
    <ol class="fp-list">
      {{#each resources}}
      <li class="fp-row fp-resource" data-id="{{id}}">
        <input type="text" class="fp-name" data-field="resourceName" value="{{name}}" maxlength="64">
        <button type="button" class="fp-icon" data-action="adjustResource" data-delta="-1"
                data-tooltip="{{localize "FEYPARTY.StepHint"}}"><i class="fa-solid fa-minus"></i></button>
        <input type="number" class="fp-num" data-field="resourceQty" value="{{quantity}}" min="0" step="1">
        <button type="button" class="fp-icon" data-action="adjustResource" data-delta="1"
                data-tooltip="{{localize "FEYPARTY.StepHint"}}"><i class="fa-solid fa-plus"></i></button>
        {{#if @root.canManage}}
        <button type="button" class="fp-icon fp-danger" data-action="removeResource"
                data-tooltip="FEYPARTY.RemoveResource"><i class="fa-solid fa-trash"></i></button>
        {{/if}}
        <input type="text" class="fp-notes" data-field="resourceNotes" value="{{notes}}" maxlength="500"
               placeholder="{{localize "FEYPARTY.Notes"}}">
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="fp-empty">{{localize "FEYPARTY.NoResources"}}</p>
    {{/if}}

    <div class="fp-form fp-add-resource">
      <input type="text" data-draft="resourceName" maxlength="64" placeholder="{{localize "FEYPARTY.ResourceName"}}">
      <input type="number" data-draft="resourceQty" min="0" step="1" class="fp-short" placeholder="{{localize "FEYPARTY.Quantity"}}">
      <input type="text" data-draft="resourceNotes" maxlength="500" placeholder="{{localize "FEYPARTY.Notes"}}">
      <button type="button" data-action="addResource" data-default>
        <i class="fa-solid fa-plus"></i> {{localize "FEYPARTY.AddResource"}}
      </button>
    </div>
  </section>

  {{!-- Activity log --}}
  <details class="fp-section fp-log" {{#if logOpen}}open{{/if}}>
    <summary class="fp-heading"><i class="fa-solid fa-scroll"></i> {{localize "FEYPARTY.Activity"}}</summary>
    {{#if log.length}}
    <ol class="fp-log-list">
      {{#each log}}
      <li><time title="{{timeLabel}}">{{timeLabel}}</time> <strong>{{user}}</strong> {{text}}</li>
      {{/each}}
    </ol>
    {{#if isGM}}
    <button type="button" class="fp-clear" data-action="clearLog">
      <i class="fa-solid fa-broom"></i> {{localize "FEYPARTY.ClearLog"}}
    </button>
    {{/if}}
    {{else}}
    <p class="fp-empty">{{localize "FEYPARTY.NoActivity"}}</p>
    {{/if}}
  </details>
</div>
