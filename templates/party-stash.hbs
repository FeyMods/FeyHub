<div class="fp-body">

  {{!-- Currency --}}
  <section class="fp-section fp-coffers">
    <header class="fp-heading">
      <i class="fa-solid fa-coins"></i>
      <span class="fp-heading-label">{{localize "FEYHUB.Stash.Coffers"}}</span>
      {{#if canManage}}
      <button type="button" class="fey-icon-btn fp-split" data-action="split" data-tooltip="FEYHUB.Stash.Split.Button">
        <i class="fa-solid fa-people-arrows"></i>
      </button>
      {{/if}}
    </header>

    {{#if currencies.length}}
    <ol class="fp-list">
      {{#each currencies}}
      <li class="fp-row fp-currency" data-id="{{id}}">
        <span class="fp-label">{{label}} <span class="fp-abbr">{{abbr}}</span></span>
        {{#if @root.canAdjust}}
        <span class="fp-stepper">
          <button type="button" class="fp-step" data-action="adjustCurrency" data-delta="-1"
                  data-tooltip="{{localize "FEYHUB.Stash.StepHint"}}"><i class="fa-solid fa-minus"></i></button>
          <input type="number" class="fp-num" data-field="currencyAmount" value="{{amount}}" min="0" step="1">
          <button type="button" class="fp-step" data-action="adjustCurrency" data-delta="1"
                  data-tooltip="{{localize "FEYHUB.Stash.StepHint"}}"><i class="fa-solid fa-plus"></i></button>
        </span>
        {{else}}
        <span class="fp-amount">{{amount}}</span>
        {{/if}}
        {{#if @root.canManage}}
        <button type="button" class="fey-icon-btn danger" data-action="removeCurrency"
                data-tooltip="FEYHUB.Stash.RemoveCurrency"><i class="fa-solid fa-trash"></i></button>
        {{/if}}
      </li>
      {{/each}}
    </ol>

    {{#if canTransact}}
    <div class="fp-form fp-transaction">
      <input type="number" class="fp-short" data-draft="txAmount" min="1" step="1" placeholder="{{localize "FEYHUB.Stash.Amount"}}">
      <select data-draft="txCurrency">
        {{#each currencies}}<option value="{{id}}">{{label}}</option>{{/each}}
      </select>
      {{#if actors.length}}
      <label class="fp-actor" data-tooltip="FEYHUB.Stash.ActorHint">
        <i class="fa-solid fa-user"></i>
        <select data-draft="txActor">
          {{#if canAdjust}}<option value="">{{localize "FEYHUB.Stash.StashOnly"}}</option>{{/if}}
          {{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </label>
      {{/if}}
      <input type="text" class="fp-note" data-draft="txNote" maxlength="120" placeholder="{{localize "FEYHUB.Stash.Note"}}">
      <div class="fp-buttons">
        <button type="button" class="fey-btn primary" data-action="transaction" data-direction="deposit">
          <i class="fa-solid fa-piggy-bank"></i> {{localize "FEYHUB.Stash.Deposit"}}
        </button>
        <button type="button" class="fey-btn" data-action="transaction" data-direction="withdraw">
          <i class="fa-solid fa-hand-holding-dollar"></i> {{localize "FEYHUB.Stash.Withdraw"}}
        </button>
      </div>
    </div>
    {{/if}}
    {{else}}
    <p class="fp-empty">{{localize "FEYHUB.Stash.NoCurrencies"}}</p>
    {{/if}}

    {{#if canManage}}
    <div class="fp-form fp-add">
      <input type="text" data-draft="currencyLabel" maxlength="32" placeholder="{{localize "FEYHUB.Stash.CurrencyName"}}">
      <input type="text" data-draft="currencyAbbr" maxlength="6" class="fp-short" placeholder="{{localize "FEYHUB.Stash.CurrencyAbbr"}}">
      <button type="button" class="fey-btn subtle" data-action="addCurrency" data-default>
        <i class="fa-solid fa-plus"></i> {{localize "FEYHUB.Stash.AddCurrency"}}
      </button>
    </div>
    {{/if}}
  </section>

  {{!-- Resources --}}
  <section class="fp-section fp-resources">
    <header class="fp-heading">
      <i class="fa-solid fa-box-open"></i>
      <span class="fp-heading-label">{{localize "FEYHUB.Stash.Resources"}}</span>
      {{#if resources.length}}<span class="fey-count">{{resources.length}}</span>{{/if}}
    </header>

    {{#if resources.length}}
    <ol class="fp-list">
      {{#each resources}}
      <li class="fp-row fp-resource" data-id="{{id}}">
        <span class="fp-resource-name">
          {{#if itemUuid}}
          <button type="button" class="fp-item" data-action="openResourceItem" data-tooltip="FEYHUB.Stash.OpenItem" draggable="true">
            <img src="{{img}}" alt="">
          </button>
          {{/if}}
          <input type="text" class="fp-name fp-inline" data-field="resourceName" value="{{name}}" maxlength="64">
        </span>
        <span class="fp-stepper">
          <button type="button" class="fp-step" data-action="adjustResource" data-delta="-1"
                  data-tooltip="{{localize "FEYHUB.Stash.StepHint"}}"><i class="fa-solid fa-minus"></i></button>
          <input type="number" class="fp-num" data-field="resourceQty" value="{{quantity}}" min="0" step="1">
          <button type="button" class="fp-step" data-action="adjustResource" data-delta="1"
                  data-tooltip="{{localize "FEYHUB.Stash.StepHint"}}"><i class="fa-solid fa-plus"></i></button>
        </span>
        <span class="fp-row-actions">
          {{#if itemUuid}}
          <button type="button" class="fey-icon-btn" data-action="unlinkResource"
                  data-tooltip="FEYHUB.Stash.UnlinkItem"><i class="fa-solid fa-link-slash"></i></button>
          {{/if}}
          {{#if @root.canManage}}
          <button type="button" class="fey-icon-btn danger" data-action="removeResource"
                  data-tooltip="FEYHUB.Stash.RemoveResource"><i class="fa-solid fa-trash"></i></button>
          {{/if}}
        </span>
        <input type="text" class="fp-notes fp-inline" data-field="resourceNotes" value="{{notes}}" maxlength="500"
               placeholder="{{localize "FEYHUB.Stash.Notes"}}">
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="fp-empty"><i class="fa-solid fa-box-open"></i> {{localize "FEYHUB.Stash.NoResources"}}</p>
    {{/if}}
    <p class="fp-hint"><i class="fa-solid fa-hand-pointer"></i> {{localize "FEYHUB.Stash.DropItemHint"}}</p>

    <div class="fp-form fp-add">
      <input type="text" data-draft="resourceName" maxlength="64" placeholder="{{localize "FEYHUB.Stash.ResourceName"}}">
      <input type="number" data-draft="resourceQty" min="0" step="1" class="fp-short" placeholder="{{localize "FEYHUB.Stash.Quantity"}}">
      <input type="text" data-draft="resourceNotes" maxlength="500" placeholder="{{localize "FEYHUB.Stash.Notes"}}">
      <button type="button" class="fey-btn subtle" data-action="addResource" data-default>
        <i class="fa-solid fa-plus"></i> {{localize "FEYHUB.Stash.AddResource"}}
      </button>
    </div>
  </section>

  {{!-- Activity log --}}
  <details class="fp-section fp-log" {{#if logOpen}}open{{/if}}>
    <summary class="fp-heading">
      <i class="fa-solid fa-chevron-right fey-caret"></i>
      <i class="fa-solid fa-scroll"></i>
      <span class="fp-heading-label">{{localize "FEYHUB.Stash.Activity"}}</span>
      {{#if log.length}}<span class="fey-count">{{log.length}}</span>{{/if}}
    </summary>
    {{#if log.length}}
    <ol class="fp-log-list">
      {{#each log}}
      <li><strong>{{user}}</strong> {{text}} <time title="{{timeLabel}}">{{timeLabel}}</time></li>
      {{/each}}
    </ol>
    {{#if isGM}}
    <button type="button" class="fey-btn subtle fp-clear" data-action="clearLog">
      <i class="fa-solid fa-broom"></i> {{localize "FEYHUB.Stash.ClearLog"}}
    </button>
    {{/if}}
    {{else}}
    <p class="fp-empty">{{localize "FEYHUB.Stash.NoActivity"}}</p>
    {{/if}}
  </details>
</div>
