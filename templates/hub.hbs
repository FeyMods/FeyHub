<div class="fey-hub-body">
  {{#unless ready}}
  <div class="fey-setup">
    <i class="fa-solid fa-hourglass-half"></i>
    <p>{{localize "FEYHUB.Warn.NotReady"}}</p>
  </div>
  {{else}}
  <nav class="fey-tabs">
    {{#each tabs}}
    <button type="button" class="fey-tab {{#if active}}active{{/if}}" data-action="switchTab" data-tab="{{id}}">
      <i class="{{icon}}"></i>
      <span class="fey-tab-label">{{label}}</span>
      {{#if hasCount}}<span class="fey-count">{{count}}</span>{{/if}}
    </button>
    {{/each}}
  </nav>

  {{#unless isStash}}
  <div class="fey-toolbar">
    <label class="fey-search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="search" class="fey-search-input" value="{{search}}" placeholder="{{localize "FEYHUB.Search"}}">
    </label>
    {{#if editable}}
    <button type="button" class="fey-btn primary" data-action="add" data-type="{{activeTab}}">
      <i class="fa-solid fa-plus"></i> {{addLabel}}
    </button>
    {{/if}}
    {{#if isGM}}
    <button type="button" class="fey-icon-btn" data-action="permissions" data-tooltip="FEYHUB.Permissions.Title">
      <i class="fa-solid fa-user-lock"></i>
    </button>
    {{/if}}
  </div>
  {{/unless}}

  <section class="fey-panel {{#if isStash}}is-stash{{/if}}">
    {{#if isQuests}}{{> "modules/FeyHub/templates/tabs/quests.hbs"}}{{/if}}
    {{#if isRumours}}{{> "modules/FeyHub/templates/tabs/rumours.hbs"}}{{/if}}
    {{#if isNPCs}}{{> "modules/FeyHub/templates/tabs/npcs.hbs"}}{{/if}}
    {{#if isNotes}}{{> "modules/FeyHub/templates/tabs/notes.hbs"}}{{/if}}
    {{#if isStash}}<div class="fey-stash">{{> "modules/FeyHub/templates/party-stash.hbs"}}</div>{{/if}}
  </section>
  {{/unless}}
</div>
